{
  "name": "origin-scoped-fetch",
  "version": "0.1.0",
  "description": "fetch that strips caller-set headers (authorization, cookie, custom API keys) when a redirect it follows crosses an origin. Node-only.",
  "keywords": [
    "fetch",
    "redirect",
    "security",
    "ssrf",
    "credential-leak",
    "authorization-header",
    "cross-origin",
    "http"
  ],
  "license": "MIT",
  "author": "kofiadeyemiq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kofiadeyemiq/origin-scoped-fetch.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "demo": "node examples/leak-demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist",
    "test:dist": "node --test test/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
